@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
    var regions = new Dictionary<string, string>
    {
        { "Russia", "RU" },
        { "France", "FR" },
        { "Germany", "EU" },
        { "UAE", "UAE" },
        { "India", "ASIA" }
    };
}

<div class="text-center">
    <form method="post">
        <div class="col-2">Текст для оценки:</div>
        <div class="col-10">
            <textarea required name="text" rows="5" cols="50"></textarea>
        </div>
        <div class="col-2">Регион:</div>
        <div class="col-7">
            <select required name="region" class="text">
            @foreach (var region in regions)
            {
                <option value="@region.Value">@region.Key</option>
            }
            </select>
        </div>
        <input class="submit-button" type="submit" />
    </form>
</div>